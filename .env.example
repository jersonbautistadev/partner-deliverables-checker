# Copy into a private environment file. These are placeholders, never working credentials.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=GENERATE_AT_LEAST_50_RANDOM_CHARACTERS
DJANGO_ALLOWED_HOSTS=your-project.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app
PUBLIC_BASE_URL=https://your-project.vercel.app
# External PostgreSQL on Vercel; use a separate database for previews.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_REQUIRE_SSL=1
# Private S3-compatible bucket/prefix. Block public access; use separate prefixes for previews.
PRIVATE_S3_BUCKET=YOUR_PRIVATE_BUCKET
PRIVATE_S3_ACCESS_KEY=SET_IN_SECRET_STORE
PRIVATE_S3_SECRET_KEY=SET_IN_SECRET_STORE
PRIVATE_S3_ENDPOINT_URL=https://YOUR_S3_ENDPOINT
PRIVATE_S3_REGION=us-east-1
PRIVATE_S3_PREFIX=production/originals
UPLOAD_MAX_BYTES=3145728
EMAIL_HOST=YOUR_SMTP_HOST
EMAIL_PORT=587
EMAIL_HOST_USER=SET_IN_SECRET_STORE
EMAIL_HOST_PASSWORD=SET_IN_SECRET_STORE
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=noreply@YOUR_VERIFIED_SENDER_DOMAIN
OPS_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
# Local runner only; never needed by the Vercel web function. Store separately from backups.
BACKUP_ENCRYPTION_KEY=BASE64_URLSAFE_32_BYTE_RANDOM_KEY
# Optional Compose target (omit DATABASE_URL and PRIVATE_S3_* when using local private files):
POSTGRES_DB=deliverables
POSTGRES_USER=deliverables
POSTGRES_PASSWORD=GENERATE_A_RANDOM_DATABASE_PASSWORD
APP_DOMAIN=YOUR_HOSTNAME
TRUST_PROXY_HEADERS=0
