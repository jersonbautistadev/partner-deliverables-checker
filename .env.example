# Local development does not need an .env file. Compose reads this file after copying to .env.
# Values below are placeholders. Generate your own keys before deployment.
DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=demo.example.com
CSRF_TRUSTED_ORIGINS=https://demo.example.com
POSTGRES_DB=deliverables
POSTGRES_USER=deliverables
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
APP_DOMAIN=demo.example.com
