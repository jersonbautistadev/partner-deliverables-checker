# Trusted backup runner only. Never put these credentials in the Vercel web app.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-an-independent-random-key-at-least-50-characters
DATABASE_URL=postgresql://MIGRATOR:PASSWORD@SESSION_POOLER:5432/DATABASE?sslmode=verify-full
DATABASE_REQUIRE_SSL=1
DATABASE_SSL_ROOT_CERT=deploy/supabase-root-ca.crt
PRIVATE_S3_BUCKET=SOURCE_PRIVATE_BUCKET
PRIVATE_S3_ACCESS_KEY=
PRIVATE_S3_SECRET_KEY=
PRIVATE_S3_ENDPOINT_URL=https://SOURCE_ENDPOINT
PRIVATE_S3_REGION=SOURCE_REGION
PRIVATE_S3_ADDRESSING_STYLE=path
PRIVATE_S3_PREFIX=originals
# Separate random 32-byte base64-url-safe AES key; keep an offline recovery copy
# OUTSIDE Backblaze. This is not the Django signing key or an S3 credential.
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_REGION=us-east-005
BACKUP_S3_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
BACKUP_S3_BUCKET=YOUR_PRIVATE_BACKUP_BUCKET
BACKUP_S3_PREFIX=staging/
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_STORAGE_LIMIT_BYTES=3221225472
BACKUP_HEALTHCHECK_URL=https://hc-ping.com/REPLACE_WITH_PRIVATE_CHECK_UUID
# Native compatible PostgreSQL 17 clients, or the workflow's container wrapper.
PG_DUMP=pg_dump
PG_RESTORE=pg_restore
